{
  "expo": {
    "name": "SecureVoult",
    "slug": "secure-password-manager",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "securevoult",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#080d1a"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.securevoult.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSFaceIDUsageDescription": "SecureVoult uses Face ID to unlock your vault.",
        "NSCameraUsageDescription": "Required for QR code scanning when pairing devices.",
        "UIBackgroundModes": ["fetch"]
      },
      "usesAppleSignIn": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#080d1a"
      },
      "package": "com.autisyncsorganization.securepasswordmanager",
      "versionCode": 1,
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "INTERNET",
        "RECEIVE_BOOT_COMPLETED"
      ],
      "allowBackup": false,
      "blockedPermissions": ["RECORD_AUDIO"]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      "expo-local-authentication",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 34,
            "targetSdkVersion": 34,
            "minSdkVersion": 29
          },
          "ios": {
            "deploymentTarget": "16.0"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "5ba33fee-86af-48ec-8c7b-5f14957ef9f4"
      }
    },
    "owner": "autisyncs-organization"
  }
}
