{
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "verify": "npm run type-check && npm run lint",
    "desktop:dev": "npm --prefix desktop run dev",
    "desktop:build": "npm --prefix desktop run build",
    "mobile:start": "npx expo start",
    "mobile:ios": "npx expo start --ios",
    "mobile:android": "npx expo start --android",
    "extension:check": "node -e \"const m=require('./extension-package/manifest.json');console.log('Extension:',m.name,'v'+m.version,'MV'+m.manifest_version);console.log('Permissions:',m.permissions.join(', '));console.log('Host permissions:',m.host_permissions.join(', '));\"",
    "extension:pack": "powershell -Command \"Compress-Archive -Force -Path extension-package\\* -DestinationPath securevoult-extension.zip; Write-Host 'Packed: securevoult-extension.zip'\"",
    "stripe:setup": "node scripts/stripe-setup.js",
    "store:prepare": "node scripts/prepare-store-listings.js",
    "env:check": "node scripts/check-env.js",
    "mobile:eas-build": "npx eas-cli@latest build --platform all --profile preview",
    "mobile:eas-submit": "npx eas-cli@latest submit --platform all"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-aspect-ratio": "^1.1.2",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.1",
    "@radix-ui/react-context-menu": "^2.2.6",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.3",
    "autoprefixer": "10.4.20",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.4",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.5.2",
    "firebase": "^12.4.0",
    "firebase-admin": "^13.8.0",
    "lucide-react": "^0.468.0",
    "mongoose": "^8.19.1",
    "next": "^16.2.4",
    "next-themes": "^0.2.1",
    "radix-ui": "^1.1.3",
    "react": "^18",
    "react-day-picker": "^9.5.1",
