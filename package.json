{
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "verify": "npm run type-check && npm run lint",
    "desktop:dev": "npm --prefix desktop run dev",
    "desktop:build": "npm --prefix desktop run build",
    "mobile:start": "npm --prefix mobile install && npx --prefix mobile expo start",
    "mobile:ios": "npm --prefix mobile install && npx --prefix mobile expo start --ios",
    "mobile:android": "npm --prefix mobile install && npx --prefix mobile expo start --android",
    "mobile:install": "npm --prefix mobile install",
    "extension:check": "node -e \"const m=require('./extension-package/manifest.json');const hostPermissions=(m.host_permissions??[]).join(', ')||'(none)';const contentScriptMatches=(m.content_scripts??[]).flatMap((script)=>script.matches??[]);console.log('Extension:',m.name,'v'+m.version,'MV'+m.manifest_version);console.log('Permissions:',m.permissions.join(', '));console.log('Host permissions:',hostPermissions);console.log('Content script matches:',contentScriptMatches.join(', ')||'(none)');\"",
    "extension:build": "node scripts/build-extension-popup.mjs",
    "extension:pack": "npm run extension:build && powershell -Command \"Compress-Archive -Force -Path extension-package\\* -DestinationPath securevoult-extension.zip; Write-Host 'Packed: securevoult-extension.zip'\"",
    "prod:phase1": "node scripts/production-audit.mjs --phase=1",
    "prod:phase2": "node scripts/production-audit.mjs --phase=2",
    "prod:phase3": "node scripts/production-audit.mjs --phase=3",
    "prod:all": "node scripts/production-audit.mjs --phase=all",
    "api:error-contract-check": "node scripts/check-api-error-contract.mjs",
    "stripe:setup": "node scripts/stripe-setup.js",
    "store:prepare": "node scripts/prepare-store-listings.js",
    "env:check": "node scripts/check-env.js",
    "icons:generate": "node scripts/generate-icons.js",
    "mobile:eas-build": "cd mobile && npx eas-cli@latest build --platform all --profile preview",
    "mobile:eas-submit": "cd mobile && npx eas-cli@latest submit --platform all",
    "test:core": "node --no-warnings scripts/vault-core-test.ts",
    "test:sync": "node --no-warnings scripts/vault-sync-test.mjs",
    "test:extension": "node --no-warnings scripts/extension-e2e.mjs && node --no-warnings scripts/passkey-e2e.mjs",
    "test": "npm run test:core && npm run test:sync && npm run test:mfa",
    "test:mfa": "node --no-warnings scripts/mfa-test.ts"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-aspect-ratio": "^1.1.2",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.1",
    "@radix-ui/react-context-menu": "^2.2.6",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.3",
    "@upstash/redis": "^1.37.0",
    "autoprefixer": "10.4.20",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.4",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.5.2",
    "firebase": "^12.4.0",
    "firebase-admin": "^13.8.0",
    "hash-wasm": "4.12.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "mongoose": "^8.19.1",
    "next": "^16.2.4",
    "next-themes": "^0.2.1",
    "nodemailer": "^10.3.1",
    "qrcode": "1.5.4",
    "radix-ui": "^1.1.3",
    "react": "^18",
    "react-day-picker": "^9.5.1",
    "react-dom": "^18",
    "react-hook-form": "^7.54.2",
    "react-resizable-panels": "^2.1.7",
    "stripe": "^22.0.2",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.40",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "1.5.5",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.0",
    "postcss": "^8",
    "prettier": "^3.3.3",
    "tailwind-merge": "^2",
    "tailwindcss": "^3",
    "tailwindcss-animate": "^1",
    "typescript": "^5"
  },
  "overrides": {
    "http-proxy-agent": "^7.0.0",
    "@grpc/grpc-js": "^1.14.7",
    "uuid": "^11.1.1"
  }
}
