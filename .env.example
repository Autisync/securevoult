# ─────────────────────────────────────────────────────────────
# SecureVoult — Environment Variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────

# ── Firebase (client-side, safe to expose to browser) ────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin (server-side ONLY, never expose to client) ─
# Project ID must match the client project above.
FIREBASE_ADMIN_PROJECT_ID=
# Service account email — Firebase Console → Project Settings → Service Accounts
FIREBASE_ADMIN_CLIENT_EMAIL=
# Private key from the downloaded service account JSON.
# Paste the full key including -----BEGIN/END----- headers.
# In .env.local, newlines MUST be represented as \n (literal backslash-n).
FIREBASE_ADMIN_PRIVATE_KEY=

# ── MongoDB ───────────────────────────────────────────────────
# Full connection string including database name.
# Example: mongodb+srv://user:pass@cluster.mongodb.net/securevoult?retryWrites=true&w=majority
MONGODB_URI=

# ── HaveIBeenPwned (server-side email breach checks) ─────────
# Obtain a key at https://haveibeenpwned.com/API/Key
# Required for: /api/admin/breach-findings/email-check
#               /api/admin/breach-findings/paste-check
# Without this key those endpoints return { notConfigured: true }.
HIBP_API_KEY=

# ── Stripe (billing / subscriptions) ─────────────────────────
# Dashboard → Developers → API keys
# Use sk_test_... in development, sk_live_... in production.
STRIPE_SECRET_KEY=
# Dashboard → Webhooks → Add endpoint → copy signing secret (whsec_...)
# For local testing run:  stripe listen --forward-to localhost:3000/api/billing/webhook
STRIPE_WEBHOOK_SECRET=
# Price IDs — run  node scripts/stripe-setup.js  to create these automatically.
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_COMPANY_MONTHLY=
STRIPE_PRICE_COMPANY_YEARLY=

# ── App URL ───────────────────────────────────────────────────
# Used to build Stripe checkout success/cancel redirect URLs.
# Development: http://localhost:3000
# Production:  https://app.securevoult.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
